      "properties": [
        {
          "cardinality": "one",
          "key": ":escalated-to/reason",
          "name": "reason",
          "required": true,
          "unique": false,
          "valueType": {
            "kind": "string"
          }
        },
        {
          "cardinality": "one",
          "key": ":escalated-to/at",
          "name": "at",
          "required": true,
          "unique": false,
          "valueType": {
            "kind": "datetime"
          }
        }
      ],
      "to": "Engineer"
    }
  ],
  "name": "model",
  "objectTypes": [
    {
      "description": "An organisation that raises tickets.",
      "kind": "object-type",
      "name": "Customer",
      "properties": [
        {
          "cardinality": "one",
          "key": ":customer/name",
          "name": "name",
          "required": true,
          "unique": false,
          "valueType": {
            "kind": "string"
          }
        }
      ]
    },
    {
      "kind": "object-type",
      "name": "Engineer",
      "properties": [
        {
          "cardinality": "one",
          "key": ":engineer/name",
          "name": "name",
          "required": true,
          "unique": false,
          "valueType": {
            "kind": "string"
          }
        }
      ]
    },
    {
      "kind": "object-type",
      "name": "Ticket",
      "properties": [
        {
          "cardinality": "one",
          "key": ":ticket/title",
          "name": "title",
          "required": true,
          "unique": false,
          "valueType": {
            "kind": "string"
          }
        },
        {
          "cardinality": "one",
          "key": ":ticket/customer",
          "name": "customer",
          "required": true,
          "unique": false,
          "valueType": {
            "kind": "ref",
            "target": "Customer"
          }
        },
        {
          "cardinality": "one",
          "key": ":ticket/status",
          "name": "status",
          "required": true,
          "unique": false,
