  ],
  "queryTypes": [
    {
      "kind": "query-type",
      "name": "open-work",
      "query": {
        "find": [
          "?title",
          "?customer",
          "?priority"
        ],
        "orderBy": [
          {
            "direction": "desc",
            "variable": "?priority"
          }
        ],
        "where": [
          [
            "?t",
            ":ticket/title",
            "?title"
          ],
          [
            "?t",
            ":ticket/priority",
            "?priority"
          ],
          [
            "?t",
            ":ticket/customer",
            "?c"
          ],
          [
            "?c",
            ":customer/name",
            "?customer"
          ],
          [
            "not",
            [
              "?t",
              ":ticket/status",
              "closed"
            ]
          ]
        ]
      }
    },
    {
      "kind": "query-type",
      "name": "escalations",
      "query": {
        "find": [
          "?title",
          "?engineer",
          "?reason"
        ],
        "where": [
          [
            "?e",
            ":escalated-to/from",
            "?t"
          ],
          [
            "?e",
            ":escalated-to/to",
            "?who"
          ],
          [
            "?e",
            ":escalated-to/reason",
            "?reason"
          ],
          [
            "?t",
            ":ticket/title",
            "?title"
          ],
          [
            "?who",
            ":engineer/name",
            "?engineer"
          ]
        ]
      }
    },
    {
      "kind": "query-type",
      "name": "tickets-by-status",
      "query": {
        "aggregate": [
          [
            "count",
            "?t",
            "?count"
          ]
        ],
        "find": [
          "?status",
          "?count"
        ],
        "where": [
          [
            "?t",
            ":ticket/status",
            "?status"
          ]
        ]
      }
    }
  ],
  "version": "0.1.0"
}